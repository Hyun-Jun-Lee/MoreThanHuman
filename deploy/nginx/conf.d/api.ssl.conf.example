server {
    listen 80;
    listen [::]:80;
    server_name api.curitalk.app;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.curitalk.app;

    ssl_certificate /etc/letsencrypt/live/api.curitalk.app/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/api.curitalk.app/privkey.pem;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:10m;
    ssl_session_tickets off;

    client_max_body_size 12m;
    limit_req_status 429;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "no-referrer-when-downgrade" always;

    location = /health {
        access_log off;
        include /etc/nginx/snippets/proxy-https.conf;
    }

    location ~ ^/(docs|redoc|openapi\.json)$ {
        auth_basic "Curitalk API docs";
        auth_basic_user_file /etc/nginx/auth/docs.htpasswd;
        limit_req zone=auth_per_ip burst=10 nodelay;
        include /etc/nginx/snippets/proxy-https.conf;
    }

    location ~ ^/api/(auth|search)/ {
        limit_req zone=auth_per_ip burst=20 nodelay;
        include /etc/nginx/snippets/proxy-https.conf;
    }

    location ~ ^/api/conversations/.*/turn/$ {
        client_max_body_size 12m;
        limit_req zone=voice_per_ip burst=5 nodelay;
        include /etc/nginx/snippets/proxy-https.conf;
    }

    location / {
        limit_req zone=api_per_ip burst=40 nodelay;
        include /etc/nginx/snippets/proxy-https.conf;
    }
}
