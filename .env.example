# Database Configuration
# SQLite (기본값, 별도 설치 불필요)
DATABASE_URL=sqlite:///./english_learning.db
# PostgreSQL (프로덕션 환경 사용 시)
# DATABASE_URL=postgresql://user:password@localhost:5432/english_learning

# External APIs
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Required only when STT/TTS voice features are used.
# OPENAI_API_KEY=your_openai_api_key_here

# Application Settings
ENV=dev
DEBUG=true
# Add origins only for CORS-constrained clients.
CORS_ORIGINS=[]

# LLM Provider Settings
# Default provider is OpenRouter. Use Ollama only when running a local Ollama server intentionally.
LLM_PROVIDER=openrouter

# OpenRouter Model Settings (used when LLM_PROVIDER=openrouter)
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Ollama Model Settings (used when LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# Recommended: qwen2.5:7b (best quality), qwen2.5:3b (faster)
# OLLAMA_MODEL=qwen2.5:7b

# Grammar Check Model Settings (optional - separate from conversation model)
# If not set, uses the main LLM settings above
# Recommended: Use cheaper/faster models for grammar checking
# GRAMMAR_MODEL_PROVIDER=openrouter
# GRAMMAR_OPENROUTER_MODEL=openai/gpt-4o-mini
# GRAMMAR_OLLAMA_MODEL=qwen2.5:3b

# Supabase Auth
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
SUPABASE_AUTH_VERIFY_MODE=remote
SUPABASE_AUTH_TIMEOUT_SECONDS=5
# Local SQLAlchemy table creation is disabled by default because Alembic owns schema changes.
AUTO_CREATE_TABLES=false

# Legacy JWT secret is only needed if you temporarily keep old local auth tooling.
JWT_SECRET_KEY=change-this-to-a-random-256-bit-hex-string

# Common LLM Settings
MAX_TOKENS=2000
TEMPERATURE=0.7

# Search Settings (optional)
SEARCH_SUMMARY_MAX_TOKENS=600
SEARCH_QUERY_ANALYSIS_MAX_TOKENS=500
SEARCH_QUALITY_JUDGE_MAX_TOKENS=500
SEARCH_REGION=kr-kr
SEARCH_SAFESEARCH=moderate
SEARCH_RECENT_TIMELIMIT=m
SEARCH_BACKEND=auto
SEARCH_MAX_RESULTS=12
SEARCH_MIN_RELEVANT_RESULTS=2

# Conversation Settings
MAX_HISTORY_TURNS=10

# Voice Settings (STT/TTS)
STT_PROVIDER=openrouter
STT_MODEL=openai/gpt-4o-mini-transcribe
TTS_PROVIDER=openrouter
TTS_MODEL=microsoft/mai-voice-2-flash
TTS_VOICE=en-US-Harper:MAI-Voice-2-Flash
TTS_RESPONSE_FORMAT=mp3
TTS_MAX_INPUT_CHARS=4000
TTS_MAX_OUTPUT_MB=5
VOICE_MAX_UPLOAD_MB=10
VOICE_PROVIDER_TIMEOUT_SECONDS=60
