# Database Configuration
# SQLite (기본값, 별도 설치 불필요)
DATABASE_URL=sqlite:///./english_learning.db
# PostgreSQL (프로덕션 환경 사용 시)
# DATABASE_URL=postgresql://user:password@localhost:5432/english_learning

# External APIs
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Required only when STT/TTS voice features are used.
# OPENAI_API_KEY=your_openai_api_key_here

# Application Settings
ENV=dev
DEBUG=true
# Add origins only for CORS-constrained clients.
CORS_ORIGINS=[]

# 외부 HTTP 풀별 한도 (AI·Supabase 인증용 풀은 각각 별도 생성)
HTTP_MAX_CONNECTIONS=100
HTTP_MAX_KEEPALIVE_CONNECTIONS=20
HTTP_KEEPALIVE_EXPIRY_SECONDS=30
# 종료 시 문법 작업 완료를 기다리는 시간. 이후 취소·정리하고 client를 닫아요.
BACKGROUND_SHUTDOWN_GRACE_SECONDS=5

# LLM Provider Settings
# Default provider is OpenRouter. Use Ollama only when running a local Ollama server intentionally.
LLM_PROVIDER=openrouter

# OpenRouter Model Settings (used when LLM_PROVIDER=openrouter)
OPENROUTER_MODEL=google/gemini-2.0-flash-exp:free

# Ollama Model Settings (used when LLM_PROVIDER=ollama)
# OLLAMA_BASE_URL=http://localhost:11434
# Recommended: qwen2.5:7b (best quality), qwen2.5:3b (faster)
# OLLAMA_MODEL=qwen2.5:7b

# Grammar Check Model Settings (optional - separate from conversation model)
# If not set, uses the main LLM settings above
# Recommended: Use cheaper/faster models for grammar checking
# GRAMMAR_MODEL_PROVIDER=openrouter
# GRAMMAR_OPENROUTER_MODEL=openai/gpt-4o-mini
# GRAMMAR_OLLAMA_MODEL=qwen2.5:3b

# Supabase Auth
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# 서버 전용 관리자 키. 모바일 빌드나 공개 저장소에 넣지 마세요.
# SUPABASE_SECRET_KEY=your_supabase_secret_key
# Sign in with Apple 연결 해제용 서버 비밀 키 (.p8, App Store IAP 키와 별개)
# APPLE_SIGNIN_TEAM_ID=YOURTEAMID
# APPLE_SIGNIN_KEY_ID=ABCDEFGHIJ
# APPLE_SIGNIN_CLIENT_ID=com.morethanhuman.curitalk
# APPLE_SIGNIN_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----
SUPABASE_AUTH_VERIFY_MODE=auto
SUPABASE_AUTH_TIMEOUT_SECONDS=5
# 개인정보·AI 처리 동의와 게스트 데이터 이전/보관 정책
# 처리방침 안내 버전 변경은 기존 AI 동의를 무효화하지 않아요.
PRIVACY_POLICY_VERSION=2026-11-25
AI_DATA_PROCESSING_VERSION=2026-11-23
PRIVACY_POLICY_URL=https://www.curitalk.app/privacy
PRIVACY_POLICY_URL_EN=https://www.curitalk.app/en/privacy
# 현재 AI_DATA_PROCESSING_VERSION 수락 전 AI API를 차단해요.
AI_CONSENT_REQUIRED=true
GUEST_TRANSFER_RECEIPT_TTL_MINUTES=10
GUEST_RETENTION_DAYS=30
ADMIN_PUBLIC_ORIGIN=https://api.curitalk.app
# 관리자 웹 공유 입장 코드. 실제 값은 서버 .env에만 저장해요.
# ADMIN_ACCESS_CODE=replace-with-your-private-code
# Swagger token helper is dev-only unless explicitly enabled with a secret.
SWAGGER_TOKEN_ISSUER_ENABLED=false
# SWAGGER_TOKEN_ISSUER_SECRET=replace-with-a-random-secret
# Server-only key for v2 snack POST/PATCH. Never pass this value to Flutter.
# LANGUAGE_SNACKS_OPERATIONS_KEY=replace-with-a-long-random-secret
# Optional provider/model overrides; omit to use the current LLM settings.
# LANGUAGE_SNACKS_PROVIDER=openrouter
# LANGUAGE_SNACKS_MODEL=your-provider-model
# Same database as DATABASE_URL, using a direct or SESSION pooling connection.
# Never use transaction pooling for this session advisory lock. Omit when DATABASE_URL is already suitable.
# LANGUAGE_SNACKS_LOCK_DATABASE_URL=postgresql://user:password@host:5432/database
LANGUAGE_SNACKS_PER_TYPE=3
LANGUAGE_SNACKS_MAX_CALLS=100
LANGUAGE_SNACKS_HISTORY_BYTES=40000
# Local SQLAlchemy table creation is disabled by default because Alembic owns schema changes.
AUTO_CREATE_TABLES=false

# Legacy JWT secret is only needed if you temporarily keep old local auth tooling.
JWT_SECRET_KEY=change-this-to-a-random-256-bit-hex-string

# Common LLM Settings
MAX_TOKENS=2000
TEMPERATURE=0.7

# Search Settings (optional)
SEARCH_SUMMARY_MAX_TOKENS=600
SEARCH_QUERY_ANALYSIS_MAX_TOKENS=500
SEARCH_QUALITY_JUDGE_MAX_TOKENS=1000
SEARCH_QUALITY_JUDGE_MODEL=google/gemini-3.1-flash-lite
SEARCH_REGION=kr-kr
SEARCH_SAFESEARCH=moderate
SEARCH_RECENT_TIMELIMIT=m
SEARCH_BACKEND=auto
SEARCH_MAX_RESULTS=6
SEARCH_MIN_RELEVANT_RESULTS=2

# Conversation Settings
MAX_HISTORY_TURNS=3
# Keep false until migration, Apple Sandbox tests, and slot initialization are complete.
CONVERSATION_ACCESS_ENABLED=false
# Required for startup/deletion/billing. Generate independent secrets (>=32 bytes).
# Never use these placeholders as real keys. Keep historical versions during rotation.
# BILLING_HMAC_KEYS={"v1":"replace-with-an-independent-secret-at-least-32-bytes"}
# BILLING_HMAC_CURRENT_KEY=v1
# App Store Server API. Set all values in the deployed secret store; never commit a private key.
# APPLE_IAP_ENVIRONMENT=sandbox
# APPLE_IAP_BUNDLE_ID=com.morethanhuman.curitalk
# APPLE_IAP_APP_ID=1234567890

# Voice Settings (STT/TTS)
STT_PROVIDER=openrouter
STT_MODEL=openai/gpt-4o-mini-transcribe
TTS_PROVIDER=openrouter
TTS_MODEL=microsoft/mai-voice-2-flash
TTS_VOICE=en-US-Harper:MAI-Voice-2-Flash
TTS_RESPONSE_FORMAT=mp3
TTS_MAX_INPUT_CHARS=4000
TTS_MAX_OUTPUT_MB=5
VOICE_MAX_UPLOAD_MB=10
VOICE_PROVIDER_TIMEOUT_SECONDS=60
# Local development: optional absolute directory. Docker Compose overrides this with its bind mount.
# AUDIO_CACHE_DIR=/absolute/path/to/audio
AUDIO_CACHE_RETENTION_DAYS=30
# Docker Compose host bind source (create this directory before deployment).
# CURITALK_AUDIO_HOST_DIR=/var/lib/curitalk/audio
